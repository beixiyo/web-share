# 复制为 config.env 后按需修改。时长单位为毫秒
# 两个平台都使用 KEY=VALUE；配置文件中的值覆盖启动进程继承的同名变量
# 值中有空格时请用单引号或双引号括起来。不要在值后添加行内注释
HOST=
PORT=3001
# 留空自动读取本机 IPv4 网段；Docker/远程代理下填写实际局域网，多个网段以逗号分隔
# LAN_CIDRS=192.168.4.0/23,10.0.0.0/24
CLEAR_TIME=300000
DISCONNECT_DELAY=300000
ROOM_EMPTY_GRACE_MS=300000
ROOM_INVITE_TTL_MS=-1
DEFAULT_ROOM_CODE=442385

# 启用 HTTPS 时填写已有证书文件路径。两个路径必须同时设置
# 相对路径以发布包根目录为基准；证书文件不随发布包提供
# SSL_KEY_PATH=./certs/server.key
# SSL_CERT_PATH=./certs/server.crt
