{
  "name": "web-share",
  "type": "module",
  "version": "1.0.0",
  "description": "Enable **LAN** file transfer directly in browsers, no server collects information, making browsers great again!!",
  "author": "CJL <2662442385@qq.com>",
  "license": "MIT",
  "keywords": [
    "file transfer",
    "webRTC",
    "LAN",
    "share files"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/beixiyo/web-share"
  },
  "homepage": "https://github.com/beixiyo/web-share",
  "main": "index.js",
  "scripts": {
    "---dev---": "---dev---",
    "dev:server": "pnpm -F web-share-server dev",
    "dev:server:go": "pnpm -F web-share-server-go dev",
    "dev:protocol": "nodemon --watch packages/server-go/protocol --ext go --on-change-only --exec \"pnpm generate:protocol\"",
    "dev:go": "pnpm generate:protocol && pnpm build:common && run-p --print-label dev:protocol dev:common dev:server:go dev:client",
    "dev:client": "pnpm -F web-share-client dev",
    "dev:common": "pnpm -F web-share-common dev",
    "dev": "pnpm build:common && run-p dev:common dev:server dev:client",
    "preview-client": "pnpm -F web-share-client preview",
    "---build---": "---build---",
    "build:common": "pnpm -F web-share-common build",
    "build:server": "pnpm -F web-share-server build",
    "build:client": "pnpm -F web-share-client build-only",
    "generate:protocol": "pnpm -F web-share-server-go generate:protocol",
    "check:protocol": "pnpm -F web-share-server-go check:protocol",
    "test:go": "pnpm -F web-share-server-go test",
    "test:backends": "bun test ./scripts/backends.test.ts ./scripts/client-connection.test.ts",
    "build:go": "pnpm generate:protocol && pnpm build:common && pnpm build:client && pnpm -F web-share-server-go build",
    "build": "pnpm build:common && run-p build:server build:client",
    "---deploy---": "---deploy---",
    "deploy:server": "pnpm -F web-share-server deploy ./deploy --prod",
    "---lint---": "---lint---",
    "lint:server": "pnpm -F web-share-server lint",
    "lint:client": "pnpm -F web-share-client lint",
    "lint": "pnpm --parallel --stream -r lint"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.7.0",
    "@jl-org/eslint-plugins": "^1.0.0",
    "@jl-org/ts-tool": "^0.0.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.10.2",
    "@unocss/eslint-plugin": "^66.1.2",
    "eslint": "^9.21.0",
    "nodemon": "^3.1.9",
    "npm-run-all2": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "6.0.4"
  }
}
